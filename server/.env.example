# Copiar para .env.development / .env.staging / .env.production (NODE_ENV escolhe qual é carregado)
PORT=4000
API_PREFIX=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
IEC_DIR=
IEC_PUBLIC_URL=
MEDIA_FALLBACK_URL=
# Endereço público da API (com o prefixo), usado nos links de rastreio das comunicações; sem isto usa o endereço do pedido
API_PUBLIC_URL=
# Endereço público da aplicação (os botões dos e-mails automáticos); sem isto usa API_PUBLIC_URL sem o /api final
APP_PUBLIC_URL=

# Segredo para assinar os tokens de sessão e os links de rastreio. Obrigatório: gerar um valor longo e aleatório
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Origens autorizadas a chamar a API a partir do browser (separadas por vírgulas). Por omissão, APP_PUBLIC_URL.
CORS_ORIGINS=
# Nº de proxies à frente da API (ex.: 1 com Cloudflare ou 2 com Cloudflare + Apache): sem isto o limite de pedidos vê o IP do proxy
TRUST_PROXY=

# Ligações simultâneas à base de dados (por omissão 10; os alojamentos partilhados costumam limitar)
DB_POOL_SIZE=

# Pedidos mais lentos do que isto (ms) ficam registados como aviso em Monitorização > Erros do servidor (por omissão 1500)
SLOW_REQUEST_MS=
