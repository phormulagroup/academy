# Webapp React (SPA) em https://academy.<dominio>/ com a API Node em /api e os IECs em /wp-content/uploads/iec (ou /regional/wp-content/uploads/iec)
# Copiado para dist/ pelo build; fica na raiz do domínio (public_html).

Options -Indexes
DirectoryIndex index.html

# Nunca expor ficheiros que começam por ponto (.env, .git…), exceto o próprio .htaccess (que o Apache já protege)
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# Erros do próprio servidor web (o Apache responde, mas não consegue servir a app): página estática de manutenção.
# Não inclui 404: um IEC que não existe deve dar 404 e as rotas da app são tratadas pelo fallback abaixo.
ErrorDocument 500 /maintenance.html
ErrorDocument 502 /maintenance.html
ErrorDocument 503 /maintenance.html
ErrorDocument 504 /maintenance.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Marca os ficheiros com hash para a regra de cache mais abaixo
  RewriteRule ^assets/ - [E=IMMUTABLE_ASSET:1]

  # IECs: o ficheiro pode ser substituído mantendo o URL (QRCode impresso), por isso tem de revalidar sempre
  RewriteRule ^(?:regional/)?wp-content/uploads/iec/ - [E=IEC_REVALIDATE:1]

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # A pasta dos IECs aberta sem nome de ficheiro (nunca listamos a pasta): vai para a página inicial da app
  RewriteRule ^(?:regional/)?wp-content/uploads/iec/?$ / [R=302,L]

  # IEC que não está na pasta pública (ainda está na pasta da API): redireciona para o mesmo ficheiro servido pelo Node.
  # Se o ficheiro existir aqui, o Apache serve-o diretamente (sem redirect). 302 (e não 301) para ninguém o guardar em cache.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(?:regional/)?wp-content/uploads/iec/(.+)$ /api/iecs/$1 [R=302,L]

  # A API Node (/api) e os IECs (QRCodes impressos) nunca são reescritos para a app.
  # Os IECs são ficheiros reais servidos diretamente pelo Apache; se o ficheiro não existir devolve 404 (e não o index.html).
  RewriteRule ^(api|(?:regional/)?wp-content/uploads/iec)(/|$) - [L]

  # SPA: tudo o que não é ficheiro nem pasta existente vai para a app (react-router)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# O motor do visualizador de PDFs (assets/pdfium-<hash>.wasm) tem de ir com o tipo certo para o browser o compilar em streaming
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

# Cache: só o que está em /assets tem hash no nome (imutável). O resto (index.html, animation.json, imagens) revalida sempre.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  Header set Cache-Control "no-cache" env=IEC_REVALIDATE
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Cabeçalhos de segurança (todas as respostas da raiz do domínio; a API Node acrescenta os seus)
<IfModule mod_headers.c>
  # HTTPS obrigatório durante 1 ano (a Cloudflare também pode definir; sem includeSubDomains/preload de propósito)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Política de conteúdo: só carrega scripts do próprio domínio (e do player do Vimeo). Limita o dano de um XSS e impede a página de ser
  # incorporada noutro site. Se algo legítimo deixar de carregar, a consola do browser diz "Refused to ... Content Security Policy"; para só
  # observar sem bloquear, trocar o nome do cabeçalho por Content-Security-Policy-Report-Only.
  #  - styles: 'unsafe-inline' (o antd e o editor injetam estilos) + Google Fonts e rsms.me (a fonte Inter do editor de páginas)
  #  - img/media: https: (imagens do conteúdo escrito no editor e bandeiras em flagcdn.com), data: e blob:
  #  - frame-src: vídeos do Vimeo; connect-src: a API do próprio domínio e o Vimeo
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://player.vimeo.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://rsms.me; font-src 'self' data: https://fonts.gstatic.com https://rsms.me; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: https://*.vimeo.com; frame-src 'self' blob: https://player.vimeo.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Editor de e-mails (GrapesJS): precisa de 'unsafe-eval' (os seus modelos usam new Function) e do Font Awesome da cdnjs. Fica só nestas páginas de administração;
  # o resto do site mantém a política acima, sem eval.
  <If "%{REQUEST_URI} =~ m#^/admin/(templates|communications)/[0-9]+/editor#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://player.vimeo.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://rsms.me; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com https://rsms.me; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: https://*.vimeo.com; frame-src 'self' blob: https://player.vimeo.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
